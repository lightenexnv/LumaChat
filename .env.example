VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Optional. Leave empty to use the Firebase project's auth domain. Only set
# this to the deployed app hostname after registering that exact hostname and
# its /__/auth/handler URI in the Google OAuth web client.
VITE_FIREBASE_FIRST_PARTY_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional TURN server(s). Use comma-separated URLs when your provider gives
# multiple transports/ports. Keep credentials out of source control.
VITE_TURN_URL=
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
